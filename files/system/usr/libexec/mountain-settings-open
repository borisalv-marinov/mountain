#!/usr/bin/env bash
set -uo pipefail # not -e: a failed step must not end the script early (never fail the login)
# Open Settings on one page: mountain-settings-open privacy (used by the "Security" start-menu entry); also display, sound, bluetooth, nightlight, language, typing, notifications, mouse, defaultapps, power, network, accessibility, about, storage, startup, datetime, lockscreen, colors, controllers, printers, youraccount.
[[ -n ${XDG_RUNTIME_DIR:-} ]] || { echo "no XDG_RUNTIME_DIR: run this from your own session" >&2; exit 1; }
printf '%s' "${1:-home}" > "$XDG_RUNTIME_DIR/mountain-settings-page"
exec plasmawindowed org.mountain.settings
