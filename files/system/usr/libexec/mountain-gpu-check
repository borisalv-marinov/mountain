#!/usr/bin/env bash
# Offers the mountain-nvidia / mountain image when the GPU does not match. Never switches by itself.
# Usage: mountain-gpu-check [--dry-run]   detect and print only (boot unit; offline, no downloads)
#        mountain-gpu-check --notify      user session: ask once per image with a Switch button
#        mountain-gpu-check --switch      root (via pkexec, from the button): the switch itself
STATE_DIR=${MOUNTAIN_STATE_DIR:-/var/lib/mountain}
MARKER=$STATE_DIR/gpu-switched
# shellcheck disable=SC1091
. "${MOUNTAIN_CONFIG:-/usr/share/mountain/config}" || { echo "mountain-gpu-check: no config"; exit 0; }

# any NVIDIA GPU counts (iGPU + NVIDIA laptops too); a hidden or switched-off dGPU never shows up, so it never recommends the NVIDIA image
has_gpu=0; lspci -nn 2>/dev/null | grep -qi '\[10de:' && has_gpu=1
is_img=0; command -v nvidia-smi >/dev/null 2>&1 && is_img=1

if [[ $has_gpu == "$is_img" ]]; then echo "nothing to do"; exit 0; fi
if [[ $has_gpu == 1 ]]; then target=$MOUNTAIN_IMAGE_NVIDIA; else target=$MOUNTAIN_IMAGE; fi
target=$target:latest
if [[ -f $MARKER && $(cat "$MARKER") == "$target" ]]; then echo "already switched"; exit 0; fi

case ${1:-} in
  --switch)
    [[ $EUID == 0 ]] || { echo "run through pkexec"; exit 1; }
    if bootc switch --enforce-container-sigpolicy "$target"; then
      mkdir -p "$STATE_DIR" && echo "$target" > "$MARKER"
    else echo "mountain-gpu-check: bootc switch failed"; exit 1; fi ;;
  --notify)
    ask=${XDG_STATE_HOME:-$HOME/.local/state}/mountain/gpu-asked
    [[ -f $ask && $(cat "$ask") == "$target" ]] && exit 0 # asked once for this image; "Not now" is final
    mkdir -p "${ask%/*}"; echo "$target" > "$ask"
    if [[ $has_gpu == 1 ]]; then msg="An NVIDIA graphics card was found. Switch to the version of Mountain made for it? It downloads several GB and needs a restart."
    else msg="No NVIDIA graphics card was found. Switch to the standard version of Mountain? It downloads several GB and needs a restart."; fi
    [[ $(notify-send -a Mountain -t 120000 -A switch=Switch -A later="Not now" "Graphics driver" "$msg" 2>/dev/null) == switch ]] || exit 0
    notify-send -a Mountain "Switching Mountain" "Downloading in the background. Keep this PC on and online; you will be told when it is done."
    if pkexec /usr/libexec/mountain-gpu-check --switch; then notify-send -a Mountain "Restart to finish" "Restart this PC to start the new version."
    else notify-send -a Mountain "Switch did not finish" "Check your internet connection and try again from the Updates app."; fi ;;
  *) echo "would switch to $target" ;;
esac
exit 0
