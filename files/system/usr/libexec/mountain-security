#!/usr/bin/env bash
# Data and actions behind Settings > Privacy & security (the Windows Security style page). Runs as the signed-in user.
#   mountain-security status          key=value lines for every card
#   mountain-security scan quick|full|DIR...   update virus definitions, then scan; found files go to quarantine
#   mountain-security scan-new        scan new files in Downloads with the definitions you have (the Downloads watcher)
#   mountain-security scan-notify F.. right-click "Scan with Mountain Security": scan, then a notification
#   mountain-security quarantine-list | quarantine-restore NAME | quarantine-delete NAME
#   mountain-security allow SERVICE on|off   firewall "Allow an app" (asks for the admin password)
#   mountain-security profile home|public    network profile of the active connection (zone mountain-home / mountain)
#   mountain-security usb on|off             USB protection (USBGuard, opt-in; keeps the devices plugged in now)
#   mountain-security rollback        go back to the previous Mountain version at the next restart
#   mountain-security reset           Reset this PC, keep my files (removes system changes made on this PC)
# Definitions download only here (Scan now / Update definitions): no background downloads (owner's rule).
set -uo pipefail
state=${XDG_DATA_HOME:-$HOME/.local/share}/mountain
quarantine=$state/quarantine
db=${MOUNTAIN_CLAMAV_DB:-/var/lib/clamav}
snaps=${MOUNTAIN_SNAP_DIR:-/var/home/.snapshots}
# "Allow an app" list: firewalld service -> name shown in Security
apps="steam-streaming:Steam Remote Play|steam-lan-transfer:Steam game transfers on your network|kdeconnect:Phone Link|samba:Share files with this PC|rdp:Remote Desktop"

newest_def() { local f; f=$(ls -t "$db"/*.c[lv]d "$db"/*.[hn]db 2>/dev/null | head -1); [[ -n $f ]] && date -r "$f" '+%Y-%m-%d %H:%M'; }

status() {
  local v
  [[ -r $state/last-scan ]] && cat "$state/last-scan" || echo "av_last=never"
  v=$(newest_def); echo "av_defs=${v:-none}"
  echo "av_quarantine=$(find "$quarantine" -type f 2>/dev/null | wc -l)"
  # read without admin rights (firewall-cmd queries need polkit): the unit, the default zone and the zone files
  if [[ $(systemctl is-active firewalld 2>/dev/null) == active ]]; then
    v=$(sed -n 's/^DefaultZone=//p' /etc/firewalld/firewalld.conf 2>/dev/null); echo "fw=on"; echo "fw_zone=${v:-mountain}"
    local c z zf s on; c=$(nmcli -t -f NAME connection show --active 2>/dev/null | grep -v '^lo$' | head -1)
    z=$(nmcli -g connection.zone connection show "$c" 2>/dev/null); z=${z:-${v:-mountain}}
    [[ $z == mountain-home ]] && echo "fw_profile=home" || echo "fw_profile=public"; echo "fw_profile_zone=$z"
    zf=/etc/firewalld/zones/$z.xml; [[ -r $zf ]] || zf=/usr/lib/firewalld/zones/$z.xml
    echo "fw_open=$(grep -oE '<(service name|port port)="[^"]*"' "$zf" 2>/dev/null | sed -E 's/.*="//; s/"$//' | paste -sd' ')"
    IFS='|' read -ra list <<<"$apps"
    for s in "${list[@]}"; do
      on=no; grep -q "<service name=\"${s%%:*}\"/>" "$zf" 2>/dev/null && on=yes
      echo "fw_app=${s%%:*}:$on:${s#*:}"
    done
  else echo "fw=off"; fi
  [[ $(systemctl is-active usbguard 2>/dev/null) == active ]] && echo usb=on || echo usb=off
  /usr/libexec/mountain-windows-boot check >/dev/null 2>&1 && echo windows=yes || echo windows=no
  echo "autolock_min=$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Timeout --default 5 2>/dev/null)"
  [[ $(systemctl --user is-enabled mountain-scan-downloads.path 2>/dev/null) == enabled ]] && echo dl_watch=on || echo dl_watch=off
  tail -5 "$state/scan-history" 2>/dev/null | sed 's/^/av_history=/'
  find "$quarantine" -maxdepth 1 -type f -printf 'av_q=%f\n' 2>/dev/null | head -20
  v=0; for a in com.discordapp.Discord dev.vencord.Vesktop com.microsoft.Edge org.mozilla.firefox org.onlyoffice.desktopeditors; do
    grep -qs '!home' "/var/lib/flatpak/overrides/$a" && v=$((v+1))
  done; echo "flatpak_tight=$v/5"
  v=$(mokutil --sb-state 2>/dev/null | head -1); case $v in *enabled*) echo sb=on ;; *disabled*) echo sb=off ;; *) echo sb=unsupported ;; esac
  [[ -e /sys/class/tpm/tpm0 ]] && echo tpm=yes || echo tpm=no
  echo "selinux=$(getenforce 2>/dev/null || echo unknown)"
  v=$(grep -o '\[[a-z]*\]' /sys/kernel/security/lockdown 2>/dev/null | tr -d '[]'); echo "lockdown=${v:-unknown}"
  lsblk -n -o TYPE 2>/dev/null | grep -qx crypt && echo encrypted=yes || echo encrypted=no
  rpm-ostree status --json 2>/dev/null | python3 -c '
import json, sys, datetime
try: d = json.load(sys.stdin)["deployments"]
except Exception: sys.exit(0)
b = next((x for x in d if x.get("booted")), d[0] if d else {})
t = b.get("timestamp")
print("upd_time=" + (datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d") if t else "unknown"))
ref = b.get("container-image-reference", "")
print("upd_signed=" + ("yes" if ref.startswith("ostree-image-signed:") else "no"))
print("rollback=" + ("yes" if any(not x.get("booted") and not x.get("staged") for x in d) else "no"))'
  v=$(busctl --system get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$(id -u)" org.freedesktop.Accounts.User PasswordMode 2>/dev/null | awk '{print $2}')
  case $v in 0) echo password=set ;; 2) echo password=none ;; *) echo password=unknown ;; esac
  v=$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Autolock --default true 2>/dev/null); echo "screenlock=${v:-true}"
  # Btrfs gives a subvolume's top directory inode 256: snapshots need /var/home to be one
  if [[ $(stat -c %i "${snaps%/.snapshots}" 2>/dev/null) == 256 ]]; then
    v=$(ls -1 "$snaps" 2>/dev/null | grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$')
    echo "snapshots=$v"; echo "snapshot_last=$(ls -1 "$snaps" 2>/dev/null | grep -E '^[0-9]{4}-' | sort | tail -1)"
  else echo "snapshots=off"; fi
}

scan() { # [--no-update] quick|full|DIR...
  local rc out found now kind update=1
  [[ ${1:-} == --no-update ]] && { update=0; shift; }
  case ${1:-full} in
    quick) kind=Quick; local d q=(); for d in Downloads Desktop Documents; do [[ -d $HOME/$d ]] && q+=("$HOME/$d"); done; set -- "${q[@]:-$HOME}" ;;
    full) kind=Full; set -- "$HOME" ;;
    *) kind=Custom ;;
  esac
  mkdir -p "$quarantine" "$state" && chmod 700 "$quarantine"
  now=$(date '+%Y-%m-%d %H:%M')
  # allowed without a password for signed-in users (polkit rule 60-mountain.rules); a failed download keeps the old definitions
  [[ $update == 1 ]] && { systemctl start mountain-virus-definitions.service 2>/dev/null || echo "note=definitions update failed, scanning with the ones you have"; }
  if [[ -z $(newest_def) ]]; then
    printf 'av_last=%s\nav_result=no-definitions\n' "$now" > "$state/last-scan"; echo "av_result=no-definitions"; return 1
  fi
  # games are never scanned: Steam, Proton prefixes, Heroic and Lutris folders (big, slow, and not where downloads land)
  out=$(nice -n 19 ionice -c3 clamscan -r -i --database="$db" --move="$quarantine" \
        --exclude-dir='/\.local/share/Steam' --exclude-dir='/\.steam' --exclude-dir='/Games' \
        --exclude-dir='/\.var/app/com\.valvesoftware\.Steam' --exclude-dir='/\.var/app/com\.heroicgameslauncher\.hgl' \
        --exclude-dir='/\.local/share/lutris' --exclude-dir='/\.local/share/mountain/quarantine' \
        --exclude='\.(part|crdownload|tmp)$' "$@" 2>&1)
  rc=$?
  find "$quarantine" -type f -exec chmod 0400 {} + 2>/dev/null # nothing in quarantine can run
  found=$(awk -F': *' '/^Infected files:/ {print $2}' <<<"$out")
  case $rc in 0) r=clean ;; 1) r=found ;; *) r=error ;; esac
  printf 'av_last=%s\nav_result=%s\nav_found=%s\n' "$now" "$r" "${found:-0}" > "$state/last-scan"
  echo "$now $kind scan: $r${found:+, $found found}" >> "$state/scan-history"
  echo "av_result=$r"; echo "av_found=${found:-0}"
  grep ' FOUND$' <<<"$out" | head -20
  [[ $r == error ]] && return 2 || return 0
}

scan_new() { # the Downloads watcher: only files changed since the last run, never downloads definitions
  local stamp=$state/downloads-scanned files
  [[ -z $(newest_def) ]] && exit 0 # no definitions yet: nothing to scan with (Scan now fetches them)
  mkdir -p "$state"; [[ -e $stamp ]] || touch -d '1 hour ago' "$stamp"
  mapfile -t files < <(find "$HOME/Downloads" -maxdepth 2 -type f -newer "$stamp" ! -name '*.part' ! -name '*.crdownload' 2>/dev/null)
  touch "$stamp"; [[ ${#files[@]} -gt 0 ]] || exit 0
  out=$(scan --no-update "${files[@]}")
  grep -q 'av_result=found' <<<"$out" && notify-send -u critical -i security-low "Mountain Security" "A threat was found in Downloads and moved to quarantine." 2>/dev/null
  echo "$out"
}

scan_notify() { # right-click > Scan with Mountain Security
  local out; out=$(scan --no-update "$@")
  case $out in
    *av_result=found*) notify-send -u critical -i security-low "Mountain Security" "Threat found and moved to quarantine." ;;
    *av_result=clean*) notify-send -i security-high "Mountain Security" "No threats found." ;;
    *) notify-send -i security-medium "Mountain Security" "No virus definitions yet: open Security and click Scan now." ;;
  esac 2>/dev/null
  echo "$out"
}

qname() { [[ $1 =~ ^[^/]+$ && -e $quarantine/$1 ]] || { echo "not in quarantine: $1" >&2; exit 2; }; }

allow() { # SERVICE on|off: only the services in the "Allow an app" list
  local svc=${1:-} want=${2:-} z
  [[ "|$apps" == *"|$svc:"* ]] || { echo "not in the list: $svc" >&2; return 2; }
  [[ $want == on || $want == off ]] || return 2
  for z in mountain mountain-home; do
    firewall-cmd --permanent --zone=$z "--$([[ $want == on ]] && echo add || echo remove)-service=$svc" >/dev/null || return 1
  done
  firewall-cmd --reload >/dev/null && echo "fw_app=$svc:$( [[ $want == on ]] && echo yes || echo no)"
}

profile() { # home|public for the active connection; Home also allows file sharing discovery and Phone Link
  local z c; case ${1:-} in home) z=mountain-home ;; public) z=mountain ;; *) return 2 ;; esac
  c=$(nmcli -t -f NAME connection show --active 2>/dev/null | grep -v '^lo$' | head -1)
  [[ -n $c ]] || { echo "no network connection" >&2; return 1; }
  nmcli connection modify "$c" connection.zone "$z" && nmcli connection up "$c" >/dev/null 2>&1; echo "fw_profile=$1"
}

reset_pc() { # Reset this PC, keep my files: drop added packages and overrides, back to the plain Mountain image
  rpm-ostree reset || return 1 # asks for the admin password; your files and apps from the App Store stay
  command -v notify-send >/dev/null && notify-send -i system-reboot "Mountain" "Restart to finish resetting this PC. Your files are kept."
  echo "reset=staged"
}

rollback() {
  rpm-ostree rollback || return 1 # asks for the admin password
  command -v notify-send >/dev/null && notify-send -i system-software-update "Mountain" "Restart to go back to the previous version."
  echo "rollback=staged"
}

case ${1:-} in
  status) status ;;
  scan) shift; scan "$@" ;;
  scan-new) scan_new ;;
  scan-notify) shift; scan_notify "$@" ;;
  quarantine-list) ls -1 "$quarantine" 2>/dev/null ;;
  quarantine-restore) qname "${2:-}"; mkdir -p "$HOME/Downloads"; chmod 0600 "$quarantine/$2"; mv -n "$quarantine/$2" "$HOME/Downloads/" ;;
  quarantine-delete) qname "${2:-}"; rm -f "$quarantine/$2" ;;
  allow) allow "${2:-}" "${3:-}" ;;
  profile) profile "${2:-}" ;;
  usb) [[ ${2:-} =~ ^(on|off)$ ]] || exit 2; pkexec /usr/libexec/mountain-usbguard "$2" ;;
  rollback) rollback ;;
  reset) reset_pc ;;
  *) echo "usage: mountain-security status|scan|scan-new|scan-notify|quarantine-*|allow|profile|usb|rollback|reset" >&2; exit 2 ;;
esac
