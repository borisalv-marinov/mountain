#!/usr/bin/env bash
# Data and actions behind Task Manager's Startup apps, Users, Services and device-name lists
# (face org.mountain.taskmanager.list). Output: tab-separated, a header line, then rows whose first field is an id.
#   mountain-taskmanager startup | startup-set FILE on|off | users | services | service start|stop|restart UNIT | device
#   | processes | apps | end PID
set -uo pipefail
sys_dir=${MOUNTAIN_AUTOSTART_SYSTEM:-/etc/xdg/autostart}
usr_dir=${XDG_CONFIG_HOME:-$HOME/.config}/autostart
# desktop parts that must always run (turning them off breaks sign-in, the taskbar or admin prompts)
core=" at-spi-dbus-bus gmenudbusmenuproxy kaccess org.kde.plasmashell org.kde.plasma-fallback-session-restore pam_kwallet_init
 polkit-kde-authentication-agent-1 powerdevil xembedsniproxy xapp-sn-watcher xdg-user-dirs mountain-user-setup spice-vdagent
 vboxclient vmware-user org.kde.foreground-booster geoclue-demo-agent "
core=${core//$'\n'/ } # one line, so every name is matched as " name "

# installed apps Windows would list in Startup apps (they register there): shown as Disabled until switched on
offers="steam.desktop com.valvesoftware.Steam.desktop com.discordapp.Discord.desktop com.spotify.Client.desktop org.telegram.desktop.desktop com.heroicgameslauncher.hgl.desktop net.lutris.Lutris.desktop"
apps_dirs=${MOUNTAIN_APPS_DIRS:-${XDG_DATA_HOME:-$HOME/.local/share}/applications $HOME/.local/share/flatpak/exports/share/applications /var/lib/flatpak/exports/share/applications /usr/share/applications}
app_file() { local d; for d in $apps_dirs; do [[ -f $d/$1 ]] && { echo "$d/$1"; return 0; }; done; return 1; }

key() { sed -n "/^\[Desktop Entry\]/,/^\[/{s/^$1=//p}" "$2" 2>/dev/null | head -1; }

startup() {
  printf 'id\tName\tStatus\tCommand\n'
  local f b src name
  for f in "$usr_dir"/*.desktop "$sys_dir"/*.desktop; do
    [[ -e $f ]] || continue
    b=$(basename "$f")
    [[ $core == *" ${b%.desktop} "* ]] && continue
    [[ $f == "$sys_dir"/* && -e $usr_dir/$b ]] && continue # the user's copy overrides the system one
    if [[ -e $sys_dir/$b ]]; then # name and command from the system entry; skip ones the system itself switched off
      src=$sys_dir/$b; [[ $(key Hidden "$src") == true ]] && continue
    else src=$f; fi
    name=$(key OnlyShowIn "$src"); [[ -n $name && ";$name" != *";KDE;"* ]] && continue
    name=$(key NotShowIn "$src"); [[ ";$name" == *";KDE;"* ]] && continue
    name=$(key Name "$src"); [[ -n $name ]] || name=${b%.desktop}
    if [[ $(key Hidden "$f") == true || $(key X-GNOME-Autostart-enabled "$f") == false ]]; then s=Disabled; else s=Enabled; fi
    printf '%s\t%s\t%s\t%s\n' "$b" "$name" "$s" "$(key Exec "$src")"
  done
  for b in $offers; do
    [[ -e $usr_dir/$b || -e $sys_dir/$b ]] && continue
    src=$(app_file "$b") || continue
    name=$(key Name "$src"); printf '%s\t%s\tDisabled\t%s\n' "$b" "${name:-${b%.desktop}}" "$(key Exec "$src")"
  done
}

startup_set() { # FILE on|off: a user override with Hidden=true is the XDG way to switch an autostart entry off
  local b=${1:-} want=${2:-} u
  # any file name the startup list shows (spaces, Cyrillic...), but never a path out of the two folders
  [[ $b == ?*.desktop && $b != */* && $b != .* ]] || { echo "bad entry: $b" >&2; return 2; }
  [[ $want == on || $want == off ]] || { echo "say on or off" >&2; return 2; }
  u=$usr_dir/$b; mkdir -p "$usr_dir"
  if [[ $want == off ]]; then
    if [[ $(key X-Mountain-Added "$u") == true ]]; then rm -f "$u"
    elif [[ -e $u ]]; then
      sed -i '/^Hidden=/d' "$u"; sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nHidden=true/' "$u"
    elif [[ -e $sys_dir/$b ]]; then
      printf '[Desktop Entry]\nHidden=true\nX-Mountain-Override=true\n' > "$u"
    else echo "no such startup app: $b" >&2; return 1; fi
  else
    if [[ $(key X-Mountain-Override "$u") == true ]]; then rm -f "$u"
    elif [[ -e $u ]]; then sed -i '/^Hidden=true/d; /^X-GNOME-Autostart-enabled=false/d' "$u"
    elif [[ " $offers " == *" $b "* ]] && src=$(app_file "$b"); then
      # a copy of the app's launcher; Steam starts in the tray (-silent), as it does on Windows
      sed '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nX-Mountain-Added=true/; /^Hidden=/d' "$src" > "$u"
      [[ $b == steam.desktop || $b == com.valvesoftware.Steam.desktop ]] && sed -i -E '/^Exec=/{/-silent/!s/^(Exec=[^ ]+)/\1 -silent/}' "$u"
    else echo "no such startup app: $b" >&2; return 1; fi
  fi
}

users() {
  printf 'id\tUser\tSessions\tCPU\tMemory\n'
  local stats a b
  # CPU now (not ps's lifetime average) as a share of all cores, like Windows: CPU ticks over half a second
  ticks() { cat /proc/[0-9]*/stat 2>/dev/null | awk '{p=$1; sub(/^.*\) /, ""); print p, $12+$13}'; }
  a=$(ticks); sleep 0.5; b=$(ticks)
  stats=$({ sed 's/^/A /' <<<"$a"; sed 's/^/B /' <<<"$b"; ps -eo pid=,user:64=,rss= | sed 's/^/U /'; } |
    awk -v hz="$(getconf CLK_TCK)" -v n="$(nproc)" '$1=="A" {a[$2]=$3} $1=="B" {b[$2]=$3} $1=="U" {u[$2]=$3; r[$2]=$4}
      END {for (p in u) {if ((p in a) && (p in b)) c[u[p]]+=b[p]-a[p]; m[u[p]]+=r[p]}
           for (x in m) {v=c[x]*100/(hz*0.5*n); printf "%s %.1f %d\n", x, (v>100?100:v), m[x]/1024}}')
  loginctl list-users --no-legend 2>/dev/null | while read -r uid name _; do
    [[ -n ${name:-} ]] || continue
    local n line
    n=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$name" '$3==u' | wc -l)
    line=$(awk -v u="$name" '$1==u' <<<"$stats")
    printf '%s\t%s\t%s\t%s %%\t%s MB\n' "$uid" "$name" "$n" "$(awk '{print $2}' <<<"${line:-x 0 0}")" "$(awk '{print $3}' <<<"${line:-x 0 0}")"
  done
}

services() { # id, Name (the unit's description, like Windows), Status, Offer (stop|start|empty = nothing to press)
  printf 'id\tName\tStatus\tOffer\n'
  local u
  u=$(systemctl list-units --type=service --all --no-legend --plain --no-pager 2>/dev/null | awk '$2!="not-found" {print $1}')
  [[ -n $u ]] || return 0
  # shellcheck disable=SC2086
  systemctl show -p Id -p Description -p Type -p RemainAfterExit -p UnitFileState -p ActiveState --no-pager -- $u 2>/dev/null |
    awk 'function out(  n, st, o) {
           if (id == "") return
           # not meant to be started by hand: image plumbing, one-shot jobs that just run and finish, idle static units
           if (id ~ /^(bazzite|bootc|ostree)-/ || (ty == "oneshot" && rae != "yes") || (uf == "static" && act != "active")) return
           n = (d != "" ? d : id); if (d == "") sub(/\.service$/, "", n)
           st = (act == "active") ? "Running" : (act == "failed" ? "Failed" : "Stopped")
           o = (st == "Running") ? "stop" : "start"
           if (id ~ /^(dbus|dbus-broker|systemd-logind|polkit|plasmalogin|sddm)\.service$/) o = "" # stopping these ends the session
           printf "%s\t%s\t%s\t%s\n", id, n, st, o
         }
         /^$/ {out(); id = d = ty = rae = uf = act = ""; next}
         {i = index($0, "="); k = substr($0, 1, i - 1); v = substr($0, i + 1)
          if (k == "Id") id = v; else if (k == "Description") d = v; else if (k == "Type") ty = v
          else if (k == "RemainAfterExit") rae = v; else if (k == "UnitFileState") uf = v; else if (k == "ActiveState") act = v}
         END {out()}' |
    sort -t$'\t' -k3,3r -k2,2
}

service() { # start|stop|restart UNIT; systemctl asks polkit, which shows the admin password prompt
  local verb=${1:-} unit=${2:-}
  [[ $verb =~ ^(start|stop|restart)$ ]] || { echo "bad action: $verb" >&2; return 2; }
  [[ $unit =~ ^[A-Za-z0-9:_.@\\-]+\.service$ ]] || { echo "bad unit: $unit" >&2; return 2; }
  systemctl "$verb" "$unit"
}

device() {
  printf 'id\tPart\tModel\n'
  local cpu ram
  cpu=$(awk -F': *' '/^model name/ {print $2; exit}' /proc/cpuinfo)
  printf 'cpu\tProcessor\t%s (%s threads)\n' "${cpu:-unknown}" "$(nproc)"
  ram=$(awk '/^MemTotal:/ {printf "%.1f GB", $2/1048576}' /proc/meminfo)
  printf 'ram\tMemory\t%s\n' "$ram"
  lspci 2>/dev/null | grep -E 'VGA|3D controller|Display controller' | sed -E 's/^[^ ]+ [^:]+: //' | while read -r g; do printf 'gpu\tGraphics\t%s\n' "$g"; done
  lsblk -d -n -o MODEL,SIZE,TYPE 2>/dev/null | awk '$NF=="disk" {NF--; print}' | while read -r d; do printf 'disk\tDisk\t%s\n' "$d"; done
  for n in /sys/class/net/*; do
    [[ -e $n/device ]] || continue
    printf 'net\tNetwork\t%s\n' "$(basename "$n")"
  done
}

# Background processes as Windows names them: the user's processes outside app scopes (apps are in the Apps table)
proc=${MOUNTAIN_PROC:-/proc}
# comm (first 15 chars of the program name) -> name; session core can not be ended (it would sign you out)
names='kwin_wayland=Desktop Window Manager|kwin_wayland_wrapper=Desktop Window Manager|kwin_x11=Desktop Window Manager
plasmashell=Windows Explorer|ksmserver=Windows Logon Application|startplasma-wayland=Windows Logon Application
plasma_session=Windows Logon Application|systemd=Service Host: User services|dbus-broker=Service Host: Messages
dbus-broker-launch=Service Host: Messages|dbus-daemon=Service Host: Messages|kded6=Service Host: Desktop services
Xwayland=Desktop Window Manager (older apps)|pipewire=Windows Audio|pipewire-pulse=Windows Audio
wireplumber=Windows Audio Device Graph|xdg-desktop-portal=Runtime Broker|xdg-desktop-portal-kde=Runtime Broker
xdg-desktop-portal-gtk=Runtime Broker|xdg-document-portal=Runtime Broker|xdg-permission-store=Runtime Broker
polkit-kde-authentication-agent-1=Consent UI for administrative apps|kwalletd6=Credential Manager
baloo_file=Search Indexer|baloo_file_extractor=Search Indexer|baloorunner=Search Indexer|kdeconnectd=Phone Link|ksystemstats=Performance counters
kactivitymanagerd=Activity history|org_kde_powerdevil=Power service|at-spi-bus-launcher=Accessibility
at-spi2-registryd=Accessibility|kaccess=Accessibility|xembedsniproxy=Notification area|gmenudbusmenuproxy=Menu bar helper
ibus-daemon=Text Input Host|plasma-browser-integration-host=Browser integration|kglobalacceld=Keyboard shortcuts
ksecretd=Credential Manager|kiod6=File transfers|kioworker=File transfers|gvfsd=File transfers
gvfsd-metadata=File System Helper|gvfsd-fuse=File System Helper|gvfsd-trash=File System Helper|gvfs-udisks2-vo=File System Helper
cupsd=Print Spooler|cups-browsed=Print Spooler|tuned-ppd=Power Profiles Service|tuned=Power Profiles Service
inotifywait=Active Protection|catatonit=Container Helper|bash=Command Shell
sshd=SSH Server|sshd-session=SSH Server|systemd-nsresourced=Namespace Resource Service|findmnt=Drive Watcher
plasmalogin=Sign-in screen'
# comm names (15 chars) that must never be ended: ending them signs you out or breaks admin prompts, audio, portals
locked='^(plasmashell|kwin_.*|ksmserver|startplasma.*|plasma_session|systemd|dbus-.*|Xwayland|kded6|polkit.*|at-spi.*|xdg-desktop-por.*|xdg-document-po.*|xdg-permission-.*|pipewire.*|wireplumber|plasmalogin|sddm.*)$'

# Task Manager row icons (Windows shows one per process); a program without one gets its own name, which Task Manager
# looks up as an icon and otherwise shows the generic program icon
icons='kwin_wayland=preferences-system-windows|plasmashell=system-file-manager|kaccess=preferences-desktop-accessibility|at-spi2-registr=preferences-desktop-accessibility|at-spi-bus-laun=preferences-desktop-accessibility|polkit-kde-auth=dialog-password|baloo_file=system-search|baloorunner=system-search|cupsd=printer|inotifywait=security-high|tuned-ppd=battery|pipewire=audio-card|pipewire-pulse=audio-card|wireplumber=audio-card|bash=utilities-terminal|ksmserver=system-log-out|kded6=preferences-system|xdg-desktop-por=preferences-system|kdeconnectd=kdeconnect'

processes() { # [apps]: background processes (default), or the Apps table: processes in app scopes, one row per app
  printf 'id\tName\tCPU\tMemory\tLocked\tIcon\n'
  local d own=() a b cg nm="" id f want=${1:-background}
  for d in "$proc"/[0-9]*; do [[ -O $d && ${d##*/} != "$$" && ${d##*/} != "$PPID" ]] && own+=("$d"); done
  ((${#own[@]})) || return 0
  a=$(cat "${own[@]/%//stat}" 2>/dev/null); sleep 0.5; b=$(cat "${own[@]/%//stat}" 2>/dev/null)
  # pid and app id from the unit Plasma starts each app in: app-ID@UUID.service (KIO with systemd >= 250: Start, taskbar;
  # UUID is 32 hex digits), app-[flatpak-]ID-RANDOM.scope (older KIO, Flatpak), or (D-Bus-activated apps such as Dolphin
  # from "Open folder") [app-]dbus[\]x2d:1.N[\]x2dID@N.service; '-' in ID is [\]x2d. Autostart services (app-ID@autostart.service)
  # stay background processes
  cg=$(grep -HE '/app-[^/]*\.scope$|/app-[^/@]*@[0-9a-f]{32}\.service$|/(app-)?dbus[\]x2d:[0-9.]+[\]x2d[^/]*@[0-9]+\.service$' "${own[@]/%//cgroup}" 2>/dev/null |
    sed -E '/dbus[\]x2d:/{s|.*/([0-9]+)/cgroup:.*/(app-)?dbus[\]x2d:[0-9.]+[\]x2d([^/]*)@[0-9]+\.service$|\1 \3|; s/[\]x2d/-/g; b;}
      /@[0-9a-f]{32}\.service$/{s|.*/([0-9]+)/cgroup:.*/app-([^/@]*)@[0-9a-f]{32}\.service$|\1 \2|; s/[\]x2d/-/g; b;}
      s|.*/([0-9]+)/cgroup:.*/app-([^/]*)\.scope$|\1 \2|; s/ flatpak-/ /; s/ (.*)-[^-]*$/ \1/; s/[\]x2d/-/g')
  if [[ $want == apps ]]; then # app names and icons from their launchers, like Windows
    while read -r id; do
      [[ -n $id ]] || continue
      if f=$(app_file "$id.desktop"); then nm+="N $id"$'\t'"$(key Name "$f")"$'\t'"$(key Icon "$f")"$'\n'; fi
    done < <(awk '{print $2}' <<<"$cg" | sort -u)
  fi
  { sed 's/^/C /' <<<"$cg"; printf '%s' "$nm"; sed 's/^/A /' <<<"$a"; sed 's/^/B /' <<<"$b"; } |
    names=$names locked=$locked icons=$icons awk -v want="$want" -v hz="$(getconf CLK_TCK)" -v n="${MOUNTAIN_NPROC:-$(nproc)}" -v pg="$(getconf PAGESIZE)" '
    BEGIN {lk_re = ENVIRON["locked"]; ki = split(ENVIRON["icons"], im, "|"); for (i = 1; i <= ki; i++) {e = index(im[i], "="); ico[substr(im[i], 1, e - 1)] = substr(im[i], e + 1)}; k = split(ENVIRON["names"], m, /[|\n]/); for (i = 1; i <= k; i++) {e = index(m[i], "="); nm[substr(m[i], 1, (e - 1 > 15 ? 15 : e - 1))] = substr(m[i], e + 1)}}
    $1 == "C" {app[$2] = $3; next}
    $1 == "N" {split($0, q, "\t"); an[$2] = q[2]; ai[$2] = q[3]; next}
    {pid = $2; c = $0; sub(/^[A-Z] [0-9]+ \(/, "", c); r = c; sub(/\) [^)]*$/, "", c); sub(/^.*\) /, "", r); split(r, f, " ")
     if ($1 == "A") {t[pid] = f[12] + f[13]; next}
     if (f[1] == "Z" || (pid in app) != (want == "apps")) next
     v = (pid in t) ? (f[12] + f[13] - t[pid]) * 100 / (hz * 0.5 * n) : 0; mb = f[22] * pg / 1048576
     if (want == "apps") {a = app[pid]; w = (an[a] != "" ? an[a] : a); x = (ai[a] != "" ? ai[a] : a)}
     else {w = (c in nm ? nm[c] : c); x = (c in ico ? ico[c] : c); if (c ~ lk_re) lk[w] = "locked"}
     if (!(w in cnt)) order[++no] = w; cnt[w]++; ids[w] = (w in ids ? ids[w] "," : "") pid; if (!(w in ic)) ic[w] = x; cpu[w] += v; mem[w] += mb}
    END {for (i = 1; i <= no; i++) {w = order[i]; printf "%s\t%s%s\t%.1f %%\t%s\t%s\t%s\n", ids[w], w, (cnt[w] > 1 && want != "apps" ? " (" cnt[w] ")" : ""), (cpu[w] > 100 ? 100 : cpu[w]), (mem[w] >= 1024 ? sprintf("%.1f GB", mem[w] / 1024) : sprintf("%.1f MB", mem[w])), lk[w], ic[w]}}' |
    sort -t$'\t' -k2,2 -k1,1n
}

# End task, like Windows: PID[,PID...] (a whole app or merged row), each only a process of this user and never the session core;
# TERM to all of them at once, then KILL whatever is still running after 3 s (one TERM alone let apps that hide in the tray live on)
end_task() {
  local p c pids=() rc=0
  for p in ${1//,/ }; do
    [[ $p =~ ^[1-9][0-9]{0,9}$ ]] || { echo "bad process id: $p" >&2; return 2; }
    ((EUID != 0)) && [[ -O /proc/$p ]] || { echo "not your process: $p" >&2; rc=1; continue; }
    c=$(cat "/proc/$p/comm" 2>/dev/null)
    [[ $c =~ $locked ]] && { echo "Ending $c would sign you out or break the desktop." >&2; rc=1; continue; }
    pids+=("$p")
  done
  ((${#pids[@]})) || return $rc
  kill -TERM -- "${pids[@]}" 2>/dev/null
  for _ in 1 2 3 4 5 6; do
    p=(); for c in "${pids[@]}"; do kill -0 -- "$c" 2>/dev/null && p+=("$c"); done
    ((${#p[@]})) || return $rc; sleep 0.5
  done
  kill -KILL -- "${p[@]}" 2>/dev/null; return $rc
}

case ${1:-} in
  startup) startup ;;
  startup-set) startup_set "${2:-}" "${3:-}" ;;
  users) users ;;
  services) services ;;
  service) service "${2:-}" "${3:-}" ;;
  device) device ;;
  processes) processes ;;
  apps) processes apps ;;
  end) end_task "${2:-}" ;;
  *) echo "usage: mountain-taskmanager startup|startup-set FILE on|off|users|services|service VERB UNIT|device|processes|apps|end PID" >&2; exit 2 ;;
esac
