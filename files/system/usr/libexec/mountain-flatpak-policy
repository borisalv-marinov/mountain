#!/usr/bin/env bash
# Tighter sandbox for the shipped non-gaming Flatpak apps: no home folder (files go through the "Open" dialog instead),
# Downloads allowed; Office also Documents and Desktop. Game launchers keep their own permissions (gaming-safe).
# Runs at every boot (system overrides live in /var, which image updates don't touch). Undo for one app:
#   sudo flatpak override --system --reset APP-ID
set -euo pipefail
tight() { flatpak override --system --nofilesystem=home --nofilesystem=host --filesystem=xdg-download "$@" || echo "mountain-flatpak-policy: skipped ${*: -1}"; }
for a in com.discordapp.Discord dev.vencord.Vesktop com.microsoft.Edge org.mozilla.firefox; do tight "$a"; done
tight --filesystem=xdg-documents --filesystem=xdg-desktop org.onlyoffice.desktopeditors
