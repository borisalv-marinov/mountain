#!/usr/bin/env bash
# Launch an AI agent CLI, installing it per-user on first use.
# Test overrides: MOUNTAIN_AI_DRYRUN=1 prints the install command; MOUNTAIN_AI_OFFLINE=1 fakes no network.
export PATH="$HOME/.local/bin:$PATH"
npm_i() { echo "npm install -g --prefix \"\$HOME/.local\" $1"; }
case "${1:-}" in
  claude)  name="Claude Code"; cmd='curl -fsSL https://claude.ai/install.sh | bash' ;;
  codex)   name="Codex";       cmd=$(npm_i @openai/codex) ;;
  gemini)  name="Gemini CLI";  cmd=$(npm_i @google/gemini-cli) ;;
  copilot) name="Copilot CLI"; cmd=$(npm_i @github/copilot) ;;
  *) echo "usage: mountain-ai <claude|codex|gemini|copilot>" >&2; exit 2 ;;
esac
command -v "$1" >/dev/null 2>&1 && exec "$1"
if [[ -n ${MOUNTAIN_AI_OFFLINE:-} ]] || { [[ -z ${MOUNTAIN_AI_DRYRUN:-} ]] && ! curl -sfI --max-time 5 https://registry.npmjs.org >/dev/null; }; then
  echo "No internet — connect and click again"; exit 1
fi
echo "Installing $name (first time only)…"
if [[ -n ${MOUNTAIN_AI_DRYRUN:-} ]]; then echo "$cmd"; exit 0; fi
bash -c "$cmd" || { echo "Install failed"; exit 1; }
exec "$1"
