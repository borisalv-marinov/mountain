#!/usr/bin/env bash
# Runs as root all the time (mountain-protect-guard.service, a system service: a program of the user cannot stop, freeze or
# signal it). For every signed-in user who did not turn Active Protection off with the admin password (no
# /var/lib/mountain/protect-off-UID), every 5 s from /sys and /proc (no process started while all is well): if the watcher is
# stopped, waiting for a restart, frozen (systemctl freeze) or paused (SIGSTOP, a debugger), it is put back at once. Every 60 s
# (and on any trouble) a full check also removes overrides the user put in their own folders (a replacement file, a drop-in, a
# mask link). The user is told, at most once in 10 minutes. The watcher checks what arrived while it was down when it starts.
# Everything that touches the user's folders runs AS the user (the user owns those paths, so root never follows a link there);
# rm never follows links.
set -uo pipefail
declare -A cg=() last=() told=() first=()

fix_user() { # UID NAME: the full check; prints "fixed" when something had to be undone
  local uid=$1 name=$2 home info p fs st sub fixed=0 bad=() pid s
  as() { runuser -u "$name" -- env XDG_RUNTIME_DIR=/run/user/"$uid" DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$uid"/bus "$@"; }
  home=$(getent passwd "$uid" | cut -d: -f6)
  for d in "$home"/.config/systemd/user{,.control} "$home/.local/share/systemd/user" /run/user/"$uid"/systemd/{user,user.control,transient}; do # .control: set-property
    for p in "$d/mountain-protect.service" "$d/mountain-protect.service.d"; do
      [[ -e $p || -L $p ]] && bad+=("$p")
    done
  done
  # anything else systemd loaded for it from the user's folders (e.g. a drop-in for all services: ~/.config/systemd/user/service.d)
  info=$(as systemctl --user show -p FragmentPath -p DropInPaths -p FreezerState -p ControlGroup -p ActiveState -p SubState mountain-protect.service 2>/dev/null)
  for p in $(sed -n 's/^DropInPaths=//p; s/^FragmentPath=//p' <<<"$info"); do
    case $p in "$home"/*|/run/user/"$uid"/*) bad+=("$p") ;; esac
  done
  (( ${#bad[@]} )) && { as rm -rf -- "${bad[@]}"; as systemctl --user daemon-reload; fixed=1; }
  # frozen, not stopped (still "active"): systemctl --user freeze, or kill -STOP / a debugger on one of its processes
  fs=$(sed -n 's/^FreezerState=//p' <<<"$info"); [[ -z $fs || $fs == running ]] || { as systemctl --user thaw mountain-protect.service; fixed=1; }
  cg[$uid]=$(sed -n 's/^ControlGroup=//p' <<<"$info")
  if [[ -n ${cg[$uid]} && -r /sys/fs/cgroup${cg[$uid]}/cgroup.procs ]]; then
    while read -r pid; do
      s=$(</proc/"$pid"/stat) 2>/dev/null || continue; s=${s##*) }
      [[ ${s%% *} == [Tt] ]] && { as systemctl --user kill -s KILL mountain-protect.service; fixed=1; break; }
    done < /sys/fs/cgroup"${cg[$uid]}"/cgroup.procs
  fi
  st=$(sed -n 's/^ActiveState=//p' <<<"$info"); sub=$(sed -n 's/^SubState=//p' <<<"$info")
  # waiting out RestartSec after a kill counts as down: started now, not in 30 s
  [[ $st == active || ($st == activating && $sub != auto-restart) ]] && (( ! fixed )) && return 0
  as systemctl --user reset-failed mountain-protect.service 2>/dev/null
  as systemctl --user start mountain-protect.service
  cg[$uid]=$(as systemctl --user show -p ControlGroup --value mountain-protect.service 2>/dev/null)
  echo fixed
}

trouble() { # CGROUP: 0 when the watcher's cgroup is gone, empty, frozen or has a stopped/traced process
  local c=/sys/fs/cgroup$1 pid s any=0
  [[ -n $1 && -r $c/cgroup.procs ]] || return 0
  grep -qx 'frozen 1' "$c/cgroup.events" 2>/dev/null && return 0
  while read -r pid; do
    any=1; s=$(</proc/"$pid"/stat) 2>/dev/null || continue; s=${s##*) }
    [[ ${s%% *} == [Tt] ]] && return 0
  done < "$c/cgroup.procs"
  (( ! any ))
}

while :; do
  now=$SECONDS
  while read -r uid name _; do
    [[ $uid =~ ^[0-9]+$ ]] && (( uid >= 1000 )) || continue
    [[ -e /var/lib/mountain/protect-off-$uid ]] && continue
    [[ -d /run/user/$uid/systemd ]] || continue
    # a session that just began starts the watcher itself: 90 s grace (also after the guard starts at boot)
    [[ -n ${first[$uid]:-} ]] || first[$uid]=$now
    (( now - first[$uid] < 90 )) && continue
    (( now - ${last[$uid]:--999} >= 60 )) || trouble "${cg[$uid]:-}" || continue
    last[$uid]=$now
    [[ $(fix_user "$uid" "$name") == *fixed* ]] || continue
    (( now - ${told[$uid]:--9999} >= 600 )) || continue
    told[$uid]=$now
    runuser -u "$name" -- env XDG_RUNTIME_DIR=/run/user/"$uid" DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$uid"/bus \
      notify-send -a "Mountain Security" -i security-medium "Active Protection" "Active Protection was turned off by a program and has been turned back on." 2>/dev/null
  done < <(loginctl list-users --no-legend 2>/dev/null)
  sleep 5
done
