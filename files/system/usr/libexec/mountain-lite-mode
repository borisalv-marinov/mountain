#!/usr/bin/env bash
# Turn off blur/animations on weak PCs (software rendering or < 4 GB RAM).
# Usage: mountain-lite-mode [--dry-run]. Only writes to the user's ~/.config. Never fails the login.
DRY=0; [[ ${1:-} == --dry-run ]] && DRY=1

if [[ -v MOUNTAIN_RENDERER ]]; then renderer=$MOUNTAIN_RENDERER
else renderer=$(eglinfo -B 2>/dev/null | grep -m1 'OpenGL renderer string'); fi
mem_kb=${MOUNTAIN_MEM_KB:-$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)}

reason=
if grep -qiE 'llvmpipe|softpipe|swrast' <<<"$renderer"; then reason="software rendering"
elif [[ ${mem_kb:-} =~ ^[0-9]+$ ]] && (( mem_kb < 4194304 )); then reason="low memory"; fi

if [[ -z $reason ]]; then echo "lite: off"; exit 0; fi
echo "lite: on ($reason)"
[[ $DRY == 1 ]] && exit 0

kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled false
kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0
qdbus6 org.kde.KWin /KWin reconfigure || true
exit 0
