# Theme-level settings (libplasma ThemePrivate). Missing SVGs fall back to the
# default Breeze theme, recolored by this theme's colors file.
# v7 frosted glass: KWin darkens (intensity) and saturates (vibrancy) what is behind before the 0.62 tint;
# contrast 0.8 keeps dark wallpapers dark (0.3 lifted them to grey). White behind ends at 54 % before the tint.
[ContrastEffect]
enabled=true
contrast=0.8
intensity=0.55
saturation=1.8

[BlurBehindEffect]
enabled=true

[AdaptiveTransparency]
enabled=false
