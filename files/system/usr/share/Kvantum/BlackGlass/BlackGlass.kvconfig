; BlackGlass: glossy black glass with chrome rims (Mountain OS).
; Section layout and keys follow KvMojave by Tsu Jan (Kvantum, https://github.com/tsujan/Kvantum).
; Kvantum and its themes are GPL-3.0-or-later; this theme is distributed under the same license (see COPYING).
; Colors: see docs/superpowers/plans/2026-11-12-mountain-v5-black-glass.md "Design tokens".

[%General]
author=Mountain
comment=Glossy black glass with chrome rims
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=true
mirror_doc_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=7
menu_blur_radius=2
spread_menuitems=false
tooltip_shadow_depth=6
scroll_width=10
scroll_arrows=false
scroll_min_extent=40
transient_scrollbar=true
transient_groove=true
slider_width=4
slider_handle_width=18
slider_handle_length=18
center_toolbar_handle=true
check_size=18
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
; v5.1: app windows are solid (content behind must never read through); menus stay glass at 0.86
translucent_windows=false
blurring=false
popup_blurring=true
reduce_window_opacity=0
reduce_menu_opacity=14
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_interior_spacing=2
toolbar_icon_size=16
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
remove_extra_frames=true
layout_spacing=4
submenu_overlap=0
tooltip_delay=-1
animate_states=true
hide_combo_checkboxes=false
no_window_pattern=false
respect_DE=true
scrollbar_in_view=false
spin_button_width=16
submenu_delay=250
tree_branch_line=false
no_inactiveness=false

[GeneralColors]
window.color=#17191E
inactive.window.color=#17191E
base.color=#0B0C0F
inactive.base.color=#0B0C0F
alt.base.color=#131418
inactive.alt.base.color=#131418
button.color=#1E2026
light.color=#3A3D44
mid.light.color=#2C2F35
dark.color=#050607
mid.color=#1E2026
highlight.color=#2A6CC4
inactive.highlight.color=#2A6CC4
tooltip.base.color=#16181C
text.color=#F2F3F5
inactive.text.color=#F2F3F5
window.text.color=#F2F3F5
inactive.window.text.color=#F2F3F5
button.text.color=#F2F3F5
disabled.text.color=#9298A1
tooltip.text.color=#F2F3F5
highlight.text.color=#FFFFFF
inactive.highlight.text.color=#FFFFFF
link.color=#5AB0FF
link.visited.color=#B48CFF
progress.indicator.text.color=#F2F3F5

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=70
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
single_top_toolbar=false
tint_on_mouseover=0
middle_click_scroll=false
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=16
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=#F2F3F5
text.focus.color=#FFFFFF
text.press.color=#F2F3F5
text.toggle.color=#FFFFFF
text.normal.inactive.color=#F2F3F5
text.toggle.inactive.color=#FFFFFF
text.shadow=false
text.margin=1
text.iconspacing=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_width=+4

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.toggle.inactive.color=#FFFFFF

[ToolbarLineEdit]
frame.element=lineedit
interior.element=lineedit
indicator.element=arrow

[Dock]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
indicator.element=arrow

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock
text.normal.color=#F2F3F5
text.focus.color=#FFFFFF
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.focus.color=#FFFFFF

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.focus.color=#FFFFFF

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4
text.margin.top=2
text.margin.bottom=2
indicator.element=arrow

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[ToolboxTab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.boldness=2

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=14
focusFrame=false
text.margin.left=8
text.margin.right=8
text.margin.top=2
text.margin.bottom=2
text.normal.color=#A4A9B2
text.focus.color=#F2F3F5
text.toggle.color=#FFFFFF
text.normal.inactive.color=#A4A9B2
text.toggle.inactive.color=#F2F3F5
min_width=+0.2font

[TabFrame]
inherits=PanelButtonCommand
frame=true
frame.element=tabframe
interior=true
interior.element=tabframe
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
frame.expansion=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.expansion=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#A4A9B2
text.focus.color=#F2F3F5
text.press.color=#F2F3F5
text.toggle.color=#F2F3F5

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
focusFrame=false

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
text.margin=0
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=12
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4
text.normal.color=#F2F3F5
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.toggle.inactive.color=#FFFFFF

[Splitter]
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=true
interior.element=scrollbarslider
frame.left=5
frame.right=5
frame.top=5
frame.bottom=5
frame.expansion=0
indicator.element=grip
indicator.size=8

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=2
frame.bottom=2
frame.left=4
frame.right=4
frame.expansion=16
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4
text.normal.color=#F2F3F5
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
frame.expansion=0

[MenuBarItem]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=menubaritem
interior.element=menubaritem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=16
text.margin.left=6
text.margin.right=6
text.margin.top=2
text.margin.bottom=2
text.normal.color=#F2F3F5
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color=#A4A9B2
text.focus.color=#F2F3F5
text.bold=true
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow

[Menu]
inherits=PanelButtonCommand
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12
frame.element=menu
interior.element=menu
frame.expansion=0

[GroupBox]
inherits=GenericFrame
frame=true
interior=true
frame.element=group
interior.element=group
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.margin=0
text.bold=true
text.boldness=2
frame.expansion=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[ToolTip]
inherits=GenericFrame
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
text.margin=0
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window

[Dialog]
interior=true
interior.element=dialog
