[Desktop Entry]
Type=Service
MimeType=all/all;
X-KDE-Priority=TopLevel
# snapshots cover local files only (not trash:/, remote:/ or network shares)
X-KDE-Protocols=file
Actions=previousVersions

[Desktop Action previousVersions]
Name=Restore previous versions
Icon=document-revert
Exec=/usr/libexec/mountain-previous-versions %f
