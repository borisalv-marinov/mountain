// Mountain: two narrow actions a signed-in user may start without the admin password:
// download virus definitions (Scan now) and take a snapshot of the home folders.
// Everything else that needs admin rights still asks for the password.
polkit.addRule(function (action, subject) {
    // read-only firewall status for the Security page ("Allow an app" list); changes still need the password
    if (action.id === "org.fedoraproject.FirewallD1.info" || action.id === "org.fedoraproject.FirewallD1.config.info") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" && subject.local && subject.active &&
        action.lookup("verb") === "start" &&
        (action.lookup("unit") === "mountain-virus-definitions.service" ||
         action.lookup("unit") === "mountain-snapshot.service")) {
        return polkit.Result.YES;
    }
});
