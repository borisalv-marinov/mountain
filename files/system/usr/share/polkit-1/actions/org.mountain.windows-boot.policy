<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!-- Restart into Windows: only sets a one-time boot of the existing Windows Boot Manager entry, so no password -->
  <action id="org.mountain.windows-boot">
    <description>Restart into Windows</description>
    <message>Restart into Windows once</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/mountain-windows-boot</annotate>
  </action>
</policyconfig>
