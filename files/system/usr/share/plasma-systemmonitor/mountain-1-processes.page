# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000001][Appearance]
# v7.2: Mountain's list, so End task works like Windows (KDE's Quit sent one polite signal: apps that hide in the tray lived on)
chartFace=org.mountain.taskmanager.list
showTitle=true
Title=Apps

[Face-880000000001][org.mountain.taskmanager.list][General]
mode=apps

[Face-880000000002][Appearance]
chartFace=org.mountain.taskmanager.list
showTitle=true
Title=Background processes

[Face-880000000002][org.mountain.taskmanager.list][General]
mode=processes

[page]
# v7.1: the page toolbar comes from Mountain's list (no actions): one search box, no KDE "Quit Application"; any actionsFace hides "Edit Page"
actionsFace=Face-880000000002
icon=view-process-system-symbolic
loadType=
margin=2
version=1
Title=Processes

[page][row-0]
Title=
heightMode=balanced
isTitle=false
name=row-0

[page][row-0][column-0]
name=column-0
noMargins=
showBackground=true

[page][row-0][column-0][section-0]
face=Face-880000000001
isSeparator=false
name=section-0

[page][row-1]
Title=
heightMode=minimum
isTitle=false
name=row-1

[page][row-1][column-0]
name=column-0
noMargins=
showBackground=true

[page][row-1][column-0][section-0]
face=Face-880000000002
isSeparator=false
name=section-0
