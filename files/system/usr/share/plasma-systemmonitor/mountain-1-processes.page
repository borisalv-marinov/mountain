# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000001][Appearance]
chartFace=org.kde.ksysguard.applicationstable
showTitle=true
Title=Apps

[Face-880000000001][org.kde.ksysguard.applicationstable][General]
sortedColumns=appName,usage,memory
columnWidths=0.50,0.25,0.25
columnDisplay={"appName":"text","usage":"textScaled","memory":"text"}
showToolBar=false
askWhenKilling=false
sortColumn=usage

[Face-880000000002][Appearance]
chartFace=org.mountain.taskmanager.list
showTitle=true
Title=Background processes

[Face-880000000002][org.mountain.taskmanager.list][General]
mode=processes

[page]
# v7.1: no page toolbar (a second search box and KDE's "Quit Application"); Background processes keeps the one search
icon=view-process-system
loadType=
margin=2
version=1
Title=Processes

[page][row-0]
Title=
heightMode=balanced
isTitle=false
name=row-0

[page][row-0][column-0]
name=column-0
noMargins=
showBackground=true

[page][row-0][column-0][section-0]
face=Face-880000000001
isSeparator=false
name=section-0

[page][row-1]
Title=
heightMode=minimum
isTitle=false
name=row-1

[page][row-1][column-0]
name=column-0
noMargins=
showBackground=true

[page][row-1][column-0][section-0]
face=Face-880000000002
isSeparator=false
name=section-0
