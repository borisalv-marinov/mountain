# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000001][Appearance]
chartFace=org.kde.ksysguard.applicationstable
showTitle=true
Title=Apps

[Face-880000000001][org.kde.ksysguard.applicationstable][General]
sortedColumns=appName,usage,memory,ioCharactersActuallyReadRate,netInbound,netOutbound,gpu_usage
columnWidths=0.30,0.10,0.12,0.12,0.12,0.12,0.12
columnDisplay={"appName":"text","usage":"text","memory":"text","ioCharactersActuallyReadRate":"text","netInbound":"text","netOutbound":"text","gpu_usage":"text"}
showToolBar=true
askWhenKilling=false
sortColumn=usage

[Face-880000000002][Appearance]
chartFace=org.kde.ksysguard.processtable
showTitle=true
Title=Background processes

[Face-880000000002][org.kde.ksysguard.processtable][General]
sortedColumns=name,usage,memory,ioCharactersActuallyReadRate,netInbound,netOutbound,gpu_usage
columnWidths=0.30,0.10,0.12,0.12,0.12,0.12,0.12
columnDisplay={"name":"text","usage":"text","memory":"text","ioCharactersActuallyReadRate":"text","netInbound":"text","netOutbound":"text","gpu_usage":"text"}
showToolBar=true
askWhenKilling=false
sortColumn=usage
viewMode=0
