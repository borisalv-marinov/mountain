# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000003][Appearance]
chartFace=org.mountain.taskmanager.list
showTitle=true
Title=Your device

[Face-880000000003][org.mountain.taskmanager.list][General]
mode=device

[Face-880000000004][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=CPU

[Face-880000000004][Sensors]
highPrioritySensorIds=["cpu/all/usage"]

[Face-880000000005][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Memory

[Face-880000000005][Sensors]
highPrioritySensorIds=["memory/physical/used"]
totalSensors=["memory/physical/total"]

[Face-880000000006][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Disk

[Face-880000000006][Sensors]
highPrioritySensorIds=["disk/all/read", "disk/all/write"]

[Face-880000000007][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Network

[Face-880000000007][Sensors]
highPrioritySensorIds=["network/all/download", "network/all/upload"]

[Face-880000000008][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=GPU

[Face-880000000008][Sensors]
highPrioritySensorIds=["gpu/all/usage"]

