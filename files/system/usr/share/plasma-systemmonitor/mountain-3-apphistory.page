# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000009][Appearance]
chartFace=org.kde.ksysguard.applicationstable
showTitle=true
Title=CPU time per app since you signed in

[Face-880000000009][org.kde.ksysguard.applicationstable][General]
sortedColumns=appName,totalTime,usage,memory,netInbound,netOutbound
columnWidths=0.34,0.14,0.13,0.13,0.13,0.13
columnDisplay={"appName":"text","totalTime":"text","usage":"textScaled","memory":"text","netInbound":"text","netOutbound":"text"}
showToolBar=false
askWhenKilling=true
sortColumn=totalTime

[Face-880000000010][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=CPU over time

[Face-880000000010][Sensors]
highPrioritySensorIds=["cpu/all/usage"]

[Face-880000000011][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Memory over time

[Face-880000000011][Sensors]
highPrioritySensorIds=["memory/physical/used"]

[Face-880000000012][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Network over time

[Face-880000000012][Sensors]
highPrioritySensorIds=["network/all/download", "network/all/upload"]

[page]
actionsFace=Face-880000000009
icon=office-chart-line
loadType=
margin=2
version=1
Title=App history

