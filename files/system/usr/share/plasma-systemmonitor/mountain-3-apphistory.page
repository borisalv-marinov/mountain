# Mountain Task Manager page (Windows 11 tab). Format: plasma-systemmonitor src/pages/*.page

[Face-880000000009][Appearance]
chartFace=org.kde.ksysguard.applicationstable
showTitle=true
Title=CPU time per app since you signed in
Title[bg]=Процесорно време по приложение от влизането ви

[Face-880000000009][org.kde.ksysguard.applicationstable][General]
sortedColumns=appName,totalTime,usage,memory
columnWidths=0.46,0.18,0.18,0.18
columnDisplay={"appName":"text","totalTime":"text","usage":"textScaled","memory":"text"}
showToolBar=false
askWhenKilling=true
sortColumn=totalTime

[Face-880000000010][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=CPU over time
Title[bg]=Процесор във времето

[Face-880000000010][Sensors]
highPrioritySensorIds=["cpu/all/usage"]

[Face-880000000011][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Memory over time
Title[bg]=Памет във времето

[Face-880000000011][Sensors]
highPrioritySensorIds=["memory/physical/used"]

[Face-880000000012][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Network over time
Title[bg]=Мрежа във времето

[Face-880000000012][Sensors]
highPrioritySensorIds=["network/all/download", "network/all/upload"]

[page]
# v7.2: the toolbar comes from the chart (no actions), so App history has no KDE "Quit Application" (Windows has none there);
# per-app Download/Upload columns stayed empty (no per-app network counters), the network chart below shows traffic
actionsFace=Face-880000000010
icon=office-chart-line-symbolic
loadType=
margin=2
version=1
Title=App history
Title[bg]=История на приложенията

[page][row-0]
Title=
heightMode=balanced
isTitle=false
name=row-0

[page][row-0][column-0]
name=column-0
noMargins=
showBackground=true

[page][row-0][column-0][section-0]
face=Face-880000000009
isSeparator=false
