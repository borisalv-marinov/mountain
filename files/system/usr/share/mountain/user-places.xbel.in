<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xbel>
<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info" xmlns:kdepriv="http://www.kde.org/kdepriv">
 <info>
  <metadata owner="http://www.kde.org">
   <kde_places_version>4</kde_places_version>
   <withRecentlyUsed>true</withRecentlyUsed>
   <withBaloo>true</withBaloo>
   <GroupState-Remote-IsHidden>true</GroupState-Remote-IsHidden>
   <GroupState-RecentlySaved-IsHidden>true</GroupState-RecentlySaved-IsHidden>
   <GroupState-SearchFor-IsHidden>true</GroupState-SearchFor-IsHidden>
   <GroupState-Tags-IsHidden>true</GroupState-Tags-IsHidden>
   <!-- internal drives: the read-only system image shows as an unnamed, 100%-full drive; USB drives stay under Removable Devices -->
   <GroupState-Devices-IsHidden>true</GroupState-Devices-IsHidden>
  </metadata>
 </info>
@PLACES@</xbel>
