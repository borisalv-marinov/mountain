[Unit]
Description=Mountain Active Protection (real-time, local-only; scans start only when a new file appears)
After=graphical-session.target
# only the admin password turns it off: no 'stop' from a program, and the root-owned flag (mountain-protect-admin) is the one off switch
RefuseManualStop=yes
ConditionPathExists=!/var/lib/mountain/protect-off-%U
# never give up restarting: a stopped watcher would leave the PC unprotected without a word
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/mountain-protect daemon
# a program can still mask or kill it: mountain-protect-guard (system timer) puts it back within a minute
Restart=always
RestartSec=30
Nice=19
IOSchedulingClass=idle
# the watcher itself: scans run in their own unit, so these limits are for the idle part
MemoryHigh=150M
CPUQuota=10%

[Install]
WantedBy=default.target
