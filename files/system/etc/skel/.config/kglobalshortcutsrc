# Windows 11 keyboard shortcuts for every new account (Settings > Keyboard can change them).
# In the account, not /etc/xdg: the shortcut service reads only its own file.
# Format: action=active shortcuts (tab-separated),default,friendly name
[KDE Keyboard Layout Switcher]
Switch to Next Keyboard Layout=Meta+Space,Meta+Alt+K,Switch to Next Keyboard Layout

[kwin]
Window Close=none,Alt+F4,Close Window
WindowsAltF4=Alt+F4,Alt+F4,Close window, or shut down from the desktop
Overview=Meta+Tab	Meta+W,Meta+W,Toggle Overview
Edit Tiles=Meta+T,Meta+T,Toggle Tiles Editor
MountainSnapLayouts=Meta+Z,Meta+Z,Snap layouts
MountainClipboard=Meta+V,Meta+V,Clipboard history

[services][org.kde.plasma-systemmonitor.desktop]
_launch=Ctrl+Shift+Esc	Ctrl+Esc

[services][org.mountain.settings.desktop]
_launch=Meta+I

[services][mountain-winx.desktop]
_launch=Meta+X

[services][org.kde.dolphin.desktop]
_launch=Meta+E

[services][org.kde.spectacle.desktop]
RectangularRegionScreenShot=Meta+Shift+Print

[services][org.mountain.snip.desktop]
_launch=Meta+Shift+S

[services][org.mountain.run.desktop]
_launch=Meta+R

[services][org.kde.krunner.desktop]
_launch=Alt+Space	Alt+F2	Search

[plasmashell]
show-on-mouse-pos=none,Meta+V,Show Clipboard Items at Mouse Position
next activity=none,Meta+Tab,Walk through activities
