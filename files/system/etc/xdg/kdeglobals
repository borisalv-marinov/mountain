[KDE]
SingleClick=false
DoubleClickInterval=500
# snappier: animations at half length (lite mode turns them off)
AnimationDurationFactor=0.5
LookAndFeelPackage=org.mountain.desktop
widgetStyle=kvantum

[General]
ColorScheme=BlackGlass
# sharp text at 100 % and 125 %: slight hinting, RGB subpixel
XftAntialias=true
XftHintStyle=hintslight
XftSubPixel=rgb
AccentColor=61,174,233

[Icons]
Theme=We10X-dark
