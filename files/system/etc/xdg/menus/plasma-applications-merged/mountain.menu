<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Cloud Gaming</Name>
    <Directory>mountain-cloudgaming.directory</Directory>
    <Include>
      <Filename>mountain-geforcenow.desktop</Filename>
      <Filename>mountain-xboxcloud.desktop</Filename>
      <Filename>mountain-boosteroid.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Games</Name>
    <Directory>mountain-games.directory</Directory>
    <Include>
      <Filename>steam.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Game Launchers</Name>
    <Directory>mountain-launchers.directory</Directory>
    <Include>
      <Filename>com.heroicgameslauncher.hgl.desktop</Filename>
      <Filename>steam.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Browsers</Name>
    <Directory>mountain-browsers.directory</Directory>
    <Include>
      <Filename>org.mozilla.firefox.desktop</Filename>
      <Filename>com.microsoft.Edge.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Coding</Name>
    <Directory>mountain-coding.directory</Directory>
    <Include>
      <Filename>code.desktop</Filename>
      <Filename>org.kde.konsole.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>AI</Name>
    <Directory>mountain-ai.directory</Directory>
    <Include>
      <Filename>mountain-ai-claude.desktop</Filename>
      <Filename>mountain-ai-codex.desktop</Filename>
      <Filename>mountain-ai-gemini.desktop</Filename>
      <Filename>mountain-ai-copilot.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Office</Name>
    <Directory>mountain-office.directory</Directory>
    <Include>
      <Filename>org.onlyoffice.desktopeditors.desktop</Filename>
    </Include>
  </Menu>
  <Menu>
    <Name>Chat</Name>
    <Directory>mountain-chat.directory</Directory>
    <Include>
      <Filename>com.discordapp.Discord.desktop</Filename>
      <Filename>dev.vencord.Vesktop.desktop</Filename>
    </Include>
  </Menu>
</Menu>
