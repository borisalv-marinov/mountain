[General]
BrowseThroughArchives=true
ShowFullPath=false
AlwaysShowTabBar=false
# Full width: Small is a floating overlay sized before its text is set ("10 ...ers", black box over the view). Free space off: it read "0 B free" on the read-only image, Windows shows none
ShowStatusBar=FullWidth
ShowSpaceInfo=false
RememberOpenedTabs=false

# Details pane like Windows: shows the selected file (not the one under the mouse), dates as "11/9/26 at 2:03 PM"
# instead of the long "Monday, November 9, 2026 at 2:03 PM" that wrapped in the narrow pane
[InformationPanel]
showHovered=false
dateFormat=ShortFormat
