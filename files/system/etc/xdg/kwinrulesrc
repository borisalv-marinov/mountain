# File Explorer opens 1100x700 (Dolphin's own first size is 640 px wide: one icon column, breadcrumb and search pushed off the toolbar).
# Apply initially (sizerule=3): the user can still resize; only normal windows (types=1), not dialogs.
[General]
count=5
rules=mountain-explorer-size,mountain-emoji,mountain-settings-identity,mountain-settings-identity-bg,mountain-settings-focus

[mountain-explorer-size]
Description=File Explorer default size
wmclass=org.kde.dolphin
wmclassmatch=1
types=1
size=1100,700
sizerule=3

# Win+. emoji picker as a flyout: borderless 380x460 under the pointer, above, not in the taskbar or Alt+Tab (rules 2 = force).
[mountain-emoji]
Description=Emoji picker flyout
wmclass=emojier
wmclassmatch=2
noborder=true
noborderrule=2
size=380,460
sizerule=2
placement=7
placementrule=2
above=true
aboverule=2
skiptaskbar=true
skiptaskbarrule=2
skipswitcher=true
skipswitcherrule=2

# Settings runs inside plasmawindowed, so the taskbar showed Plasma's name and icon: give it the Settings app's (force).
# Only the window titled exactly "Settings" (Run, Win+X and Shut Down are plasmawindowed too).
[mountain-settings-identity]
Description=Settings shows as Settings on the taskbar
wmclass=plasmawindowed
wmclassmatch=2
title=Settings
titlematch=1
desktopfile=org.mountain.settings
desktopfilerule=2

# The same window in Bulgarian: its title comes from Name[bg] in the plasmoid's metadata.json.
[mountain-settings-identity-bg]
Description=Settings shows as Settings on the taskbar (Bulgarian)
wmclass=plasmawindowed
wmclassmatch=2
title=Настройки
titlematch=1
desktopfile=org.mountain.settings
desktopfilerule=2

# v7.4 (owner test): Settings and Security opened from Start or the taskbar stayed hidden behind other windows until the taskbar icon was clicked again.
# A window the user just asked for always gets focus (focus stealing prevention None, force). Only the window titled "Settings".
[mountain-settings-focus]
Description=Settings opens in front with focus
wmclass=plasmawindowed
wmclassmatch=2
title=Settings
titlematch=1
fsplevel=0
fsplevelrule=2
