{
  "_doc": "uxcheck.py rules: shot name (without the NN- prefix) as a regex -> checks. must_read / must_not_read: text a user must (not) see (OCR). dark_window: the app window (geometry from NAME.json) is dark like the rest of the system. ocr_quality: INFO baseline of unreadable words (overdrawn rows read as garbage).",
  "dialog-shutdown": {"must_read": ["Shut down"]},
  "file-explorer|explorer-home|fhd-file-explorer": {"must_not_read": ["0 B free"]},
  "taskbar-context-menu": {"must_read": ["Task Manager"], "must_not_read": ["Add or Manage Widgets", "Panel Configuration"]},
  "taskmanager-processes|taskmanager": {"must_read": ["End task"], "must_not_read": ["Quit Application"]},
  "taskmanager-apphistory": {"must_read": ["App history"], "must_not_read": ["Quit Application"]},
  "app-notepad": {"must_not_read": ["Recent files"]},
  "kbd-switch": {"must_not_read": ["traditional phonetic"]},
  "kbd-flyout": {"must_read": ["ENG", "Bulgarian", "More keyboard settings"], "must_not_read": ["traditional phonetic"]},
  "start-search-.*|search-settings|ux-search-.*": {"ocr_quality": true},
  "every-.*": {"dark_window": true}
}
